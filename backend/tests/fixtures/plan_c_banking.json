  {
   "id": "br_tx_account_exists",
   "description": "Every transaction must reference a valid account_id in the accounts table.",
   "tables": [
    "transactions",
    "accounts"
   ],
   "expression": "transactions.account_id in accounts.account_id",
   "severity": "error"
  },
  {
   "id": "br_running_balance",
   "description": "Running balance must update correctly based on transaction type and amount only if status is SUCCESS.",
   "tables": [
    "transactions"
   ],
   "expression": "running_balance = previous_balance + (amount if transaction_type == 'CREDIT' else -amount) if status == 'SUCCESS' else previous_balance",
   "severity": "error"
  },
  {
   "id": "br_failed_transactions",
   "description": "Failed transactions should have a small representative rate within the dataset.",
   "tables": [
    "transactions"
   ],
   "expression": "count(status == 'FAILED') / count(*) <= 0.15",
   "severity": "warning"
  }
 ],
