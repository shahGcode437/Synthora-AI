# Copy to backend/.env and fill in. NEVER commit .env.

APP_ENV=development
# Extra allowed browser origins (comma-separated, no trailing slash, never "*").
# https://synthora-ai-nine.vercel.app, http://localhost:5173 and http://127.0.0.1:5173 are always allowed.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# --- LLM Router (see docs/API.md) ---
# Provider order tried on failure (comma-separated). Grok = xAI. Not Groq.
LLM_PROVIDER_ORDER=gemini,groq
LLM_TIMEOUT_SECONDS=25
LLM_MAX_RETRIES_PER_PROVIDER=1

GEMINI_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
# Groq (groq.com, not xAI's Grok): https://console.groq.com/keys
GROQ_API_KEY=
QWEN_API_KEY=

# Any model ID your key can access (check https://ai.google.dev/gemini-api/docs/models)
GEMINI_MODEL=
# Any chat model your key can use (must support JSON mode)
OPENAI_MODEL=
XAI_MODEL=
# A Groq chat model that supports JSON mode (see the models list in the Groq console)
GROQ_MODEL=
QWEN_MODEL=
# Alibaba Cloud Model Studio OpenAI-compatible endpoint. Region/workspace specific: copy it from your
# Model Studio console (it ends with /compatible-mode/v1). Not hardcoded on purpose.
QWEN_BASE_URL=

# --- Accounts, sessions & persistence (see docs/AUTH_SETUP.md) ---
# Production: a managed PostgreSQL URL (postgres:// and postgresql:// are accepted). Keep it ONLY in the host's
# environment settings, never in git. Local default: a SQLite file (wiped on every Render deploy).
DATABASE_URL=sqlite:///./synthora.db
# Apply Alembic migrations at startup. Empty = automatic for SQLite only. With PostgreSQL either set true, or run
# `alembic upgrade head` in the start command and leave this empty (startup then just verifies the schema).
# DB_AUTO_MIGRATE=true
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
SESSION_TTL_DAYS=7
# Browser session cookie (HttpOnly). Use SESSION_COOKIE_SECURE=true in production.
# SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax
# Public Google OAuth client id (not a secret). Leave empty to disable Google sign-in.
GOOGLE_CLIENT_ID=
# true = analyze/generate/export require sign-in. false = anyone can use the generator; saving needs an account.
AUTH_REQUIRED_FOR_AI=false
# true when running behind a reverse proxy such as Render (rate limiting then uses X-Forwarded-For)
TRUST_PROXY=false
RATE_LIMIT_ENABLED=true
# auto = shared in the database on PostgreSQL, in memory on SQLite
RATE_LIMIT_BACKEND=auto
MAX_HISTORY_PER_USER=300
MAX_SCHEMAS_PER_USER=50
MAX_DATASETS_PER_USER=10
MAX_DATASET_BYTES=10000000
