{
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://synthora-ai-9ecc.onrender.com/api/:path*" },
    { "source": "/health", "destination": "https://synthora-ai-9ecc.onrender.com/health" },
    { "source": "/((?!api/|health$).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
