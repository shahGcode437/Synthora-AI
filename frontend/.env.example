# Backend URL (no trailing slash). Used for display and the interactive-docs link.
VITE_API_BASE_URL=http://127.0.0.1:8000
# true (default): the app calls its own origin and a proxy forwards /api and /health to the backend. Vite does this
# in development and vercel.json does it in production, which keeps the HttpOnly session cookie first-party.
# false: call VITE_API_BASE_URL directly (needs SESSION_COOKIE_SAMESITE=none on the backend; third-party-cookie rules apply).
VITE_API_PROXY=true
# Public Google OAuth client id (Google Cloud Console > Credentials). Optional: without it the Google button is disabled.
VITE_GOOGLE_CLIENT_ID=
# true shows sign in / sign up and the account pages (needs the backend's account endpoints). Default: off.
VITE_ACCOUNTS_ENABLED=false
